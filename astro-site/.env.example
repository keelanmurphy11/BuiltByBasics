PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Viewer token — required for Presentation draft preview (SANITY_API_READ_TOKEN)
SANITY_API_READ_TOKEN=

# Studio URL embedded in stega overlays (click-to-edit). Default: local Studio.
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Beehiiv newsletter (library "Stay in the loop" CTA)
# 1. Create a free publication at https://www.beehiiv.com
# 2. Subscribers → Subscribe forms → Create new form
# 3. Slim layout, Inline embed; email only; turn off title/subtitle
# 4. Style button #2563eb, ~10px radius, transparent background
# 5. Save → Get embed code → paste the form ID (data-beehiiv-form="..."), e.g.:
#    PUBLIC_BEEHIIV_EMBED_URL=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#    (Full <script> snippet also works; restart npm run dev after changing.)
PUBLIC_BEEHIIV_EMBED_URL=
