---
import type { LibraryResource } from '../../lib/types';
import {
  formatReadingTime,
  formatShortDate,
  getResourceLevelLabel,
} from '../../lib/library-utils';

interface Props {
  resource: LibraryResource;
}

const { resource } = Astro.props;
const typeIcon = resource.type === 'article' ? 'document' : 'clipboard';
const dateStr =
  resource.type === 'article' ? resource.updatedAt || resource.publishedAt : undefined;

const metaParts = [
  resource.resourceType,
  resource.readingTime ? formatReadingTime(resource.readingTime) : null,
  resource.duration ?? null,
  getResourceLevelLabel(resource) || null,
].filter(Boolean);
---

<a href={resource.href} class="lib-latest-row" data-resource-type={resource.type}>
  <div class="lib-latest-row__icon" aria-hidden="true">
    {
      typeIcon === 'document' && (
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      )
    }
    {
      typeIcon === 'clipboard' && (
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
      )
    }
  </div>
  <div class="lib-latest-row__body">
    <h3 class="lib-latest-row__title">{resource.title}</h3>
    <p class="lib-latest-row__meta">{metaParts.join(' · ')}</p>
  </div>
  {
    dateStr && (
      <time class="lib-latest-row__date" datetime={dateStr}>
        {formatShortDate(dateStr)}
      </time>
    )
  }
</a>
