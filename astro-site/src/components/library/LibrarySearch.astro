---
interface Props {
  variant?: 'hero' | 'feed';
  searchId?: string;
  inputName?: string;
  showSubmit?: boolean;
}

const {
  variant = 'feed',
  searchId = 'library-search',
  inputName = 'q',
  showSubmit = false,
} = Astro.props;
const placeholder =
  variant === 'hero'
    ? 'Search strength, running, nutrition…'
    : 'Search by topic or keyword — try strength, running, nutrition…';
---

<div class:list={['lib-search', variant === 'hero' && 'lib-search--hero', variant === 'feed' && 'lib-feed-search']}>
  {
    showSubmit ? (
      <button type="submit" class="lib-search__submit" aria-label="Search library">
        <svg class="lib-search__icon lib-search__icon--btn" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
    ) : (
      <svg class="lib-search__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    )
  }
  <input
    type="search"
    id={searchId}
    name={inputName}
    class="lib-search__input"
    placeholder={placeholder}
    autocomplete="off"
    aria-label="Search library resources"
  />
  {variant === 'feed' && <kbd class="lib-search__kbd" aria-hidden="true">/</kbd>}
</div>
