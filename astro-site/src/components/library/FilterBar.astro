---
import { LIBRARY_TOPICS } from '../../lib/library-config';

interface Props {
  activeTopic?: string;
  activeFormat?: string;
  activeDifficulty?: string;
  activeSort?: string;
  showTopicFilter?: boolean;
  showFormatFilter?: boolean;
  initialCount?: number;
}

const {
  activeTopic = '',
  activeFormat = '',
  activeDifficulty = '',
  activeSort = 'newest',
  showTopicFilter = true,
  showFormatFilter = true,
  initialCount = 0,
} = Astro.props;

const difficulties = [
  { value: '', label: 'All levels' },
  { value: 'beginner', label: 'Beginner' },
  { value: 'intermediate', label: 'Intermediate' },
  { value: 'advanced', label: 'Advanced' },
];

const formats = [
  { value: '', label: 'All formats' },
  { value: 'articles', label: 'Articles' },
  { value: 'programs', label: 'Programs' },
];
---

<div class="lib-toolbar-wrap" data-library-filters>
  <div class="lib-toolbar">
    <span class="lib-toolbar__count" data-feed-count>
      {initialCount} resource{initialCount === 1 ? '' : 's'}
    </span>
    <div class="lib-toolbar__actions">
      <label class="lib-toolbar__sort-label">
        <span class="sr-only">Sort by</span>
        <select class="lib-toolbar__sort" data-filter="sort" aria-label="Sort resources">
          <option value="relevance" selected={activeSort === 'relevance'}>Best match</option>
          <option value="newest" selected={activeSort === 'newest'}>Newest</option>
          <option value="popular" selected={activeSort === 'popular'}>Most Popular</option>
          <option value="updated" selected={activeSort === 'updated'}>Recently Updated</option>
        </select>
      </label>
      <button type="button" class="lib-filters__btn" data-filter-toggle aria-expanded="false" aria-controls="library-filter-panel">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        Filters
        <span class="lib-filters__badge" data-filter-badge hidden>0</span>
      </button>
    </div>
  </div>

  <div class="lib-active-pills" data-active-pills hidden></div>

  <div class="lib-filter-backdrop" data-filter-backdrop hidden></div>

  <div
    id="library-filter-panel"
    class="lib-filter-panel"
    data-filter-panel
    role="dialog"
    aria-label="Filter resources"
    hidden
  >
    <div class="lib-filter-panel__header">
      <h3 class="lib-filter-panel__title">Filters</h3>
      <button type="button" class="lib-filter-panel__close" data-filter-close aria-label="Close filters">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="lib-filter-panel__body">
      {
        showTopicFilter && (
          <div class="lib-filter-field">
            <label class="lib-filter-field__label" for="filter-topic">Topic</label>
            <select id="filter-topic" class="lib-filter-field__select" data-filter="topic">
              <option value="" selected={!activeTopic}>All topics</option>
              {LIBRARY_TOPICS.map((topic) => (
                <option value={topic.slug} selected={activeTopic === topic.slug}>
                  {topic.title}
                </option>
              ))}
            </select>
          </div>
        )
      }

      {
        showFormatFilter && (
          <div class="lib-filter-field">
            <label class="lib-filter-field__label" for="filter-format">Format</label>
            <select id="filter-format" class="lib-filter-field__select" data-filter="format">
              {formats.map((f) => (
                <option value={f.value} selected={activeFormat === f.value}>
                  {f.label}
                </option>
              ))}
            </select>
          </div>
        )
      }

      <div class="lib-filter-field">
        <label class="lib-filter-field__label" for="filter-difficulty">Level</label>
        <select id="filter-difficulty" class="lib-filter-field__select" data-filter="difficulty">
          {difficulties.map((d) => (
            <option value={d.value} selected={activeDifficulty === d.value}>
              {d.label}
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="lib-filter-panel__footer">
      <button type="button" class="lib-filter-panel__clear" data-filter-clear>Clear all</button>
    </div>
  </div>
</div>

<script id="library-topic-labels" type="application/json" set:html={JSON.stringify(
  Object.fromEntries(LIBRARY_TOPICS.map((t) => [t.slug, t.title]))
)} />
