---
interface Props {
  inline?: boolean;
}

const { inline = false } = Astro.props;

/** Form URL from Beehiiv → Get embed code (iframe src), e.g. https://subscribe-forms.beehiiv.com/<id> */
const beehiivEmbedUrl = (import.meta.env.PUBLIC_BEEHIIV_EMBED_URL as string | undefined)?.trim() || '';
---

<section class:list={['lib-cta', { 'lib-cta--inline': inline }]}>
  <div class="library-container">
    <div class="lib-cta__inner">
      <div>
        <h2 class="lib-cta__title">Stay in the loop</h2>
        <p class="lib-cta__text">
          Get notified when new articles, programs, and videos are added to the library.
        </p>
        <a href="/coaching" class="lib-cta__coaching">
          Or explore 1:1 coaching
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      {beehiivEmbedUrl ? (
        <div class="lib-cta__form lib-cta__beehiiv">
          <iframe
            src={beehiivEmbedUrl}
            class="beehiiv-embed lib-cta__beehiiv-frame"
            data-test-id="beehiiv-embed"
            frameborder="0"
            scrolling="no"
            title="Subscribe to the Built By Basics newsletter"
            loading="lazy"
          ></iframe>
          <script is:inline async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
        </div>
      ) : (
        <div class="lib-cta__form lib-cta__form--unconfigured" role="status">
          <p class="lib-cta__setup-note">
            Set <code>PUBLIC_BEEHIIV_EMBED_URL</code> in <code>astro-site/.env</code> to your Beehiiv
            Slim Inline form URL (see <code>.env.example</code>).
          </p>
        </div>
      )}
    </div>
  </div>
</section>
