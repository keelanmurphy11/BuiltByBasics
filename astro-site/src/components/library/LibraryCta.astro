---
interface Props {
  inline?: boolean;
}

const { inline = false } = Astro.props;
---

<section class:list={['lib-cta', { 'lib-cta--inline': inline }]}>
  <div class="library-container">
    <div class="lib-cta__inner">
      <div>
        <h2 class="lib-cta__title">Stay in the loop</h2>
        <p class="lib-cta__text">
          Get notified when new articles, programs, and videos are added to the library.
        </p>
        <a href="/coaching" class="lib-cta__coaching">
          Or explore 1:1 coaching
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      <form class="lib-cta__form" action="#" method="post" onsubmit="return false;">
        <input
          type="email"
          class="lib-cta__input"
          placeholder="you@example.com"
          aria-label="Email address for newsletter"
          required
        />
        <button type="submit" class="lib-cta__btn">Subscribe</button>
      </form>
    </div>
  </div>
</section>
