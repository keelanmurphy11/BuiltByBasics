---
interface Props {
  inline?: boolean;
}

const { inline = false } = Astro.props;

/**
 * Accepts any of:
 * - Full Beehiiv embed snippet: <script ... data-beehiiv-form="UUID"></script>
 * - Form URL: https://subscribe-forms.beehiiv.com/UUID
 * - Form ID UUID alone
 */
const rawEmbed = (import.meta.env.PUBLIC_BEEHIIV_EMBED_URL as string | undefined)?.trim() || '';

function parseBeehiivFormId(value: string): string {
  if (!value) return '';
  const fromAttr = value.match(/data-beehiiv-form=["']([0-9a-f-]{36})["']/i);
  if (fromAttr) return fromAttr[1];
  const fromUrl = value.match(/subscribe-forms\.beehiiv\.com\/(?:v3\/forms\/)?([0-9a-f-]{36})/i);
  if (fromUrl) return fromUrl[1];
  if (/^[0-9a-f-]{36}$/i.test(value)) return value;
  return '';
}

const beehiivFormId = parseBeehiivFormId(rawEmbed);

/** Exact Beehiiv v3 snippet — data-beehiiv-form must live on the script tag */
const beehiivEmbedHtml = beehiivFormId
  ? `<script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="${beehiivFormId}"></script>`
  : '';
---

<section class:list={['lib-cta', { 'lib-cta--inline': inline }]}>
  <div class="library-container">
    <div class="lib-cta__inner">
      <div>
        <h2 class="lib-cta__title">Stay in the loop</h2>
        <p class="lib-cta__text">
          Get notified when new articles, programs, and videos are added to the library.
        </p>
        <a href="/coaching" class="lib-cta__coaching">
          Or explore 1:1 coaching
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      {beehiivFormId ? (
        <div class="lib-cta__form lib-cta__beehiiv" set:html={beehiivEmbedHtml} />
      ) : (
        <div class="lib-cta__form lib-cta__form--unconfigured" role="status">
          <p class="lib-cta__setup-note">
            Set <code>PUBLIC_BEEHIIV_EMBED_URL</code> in <code>astro-site/.env</code> to your Beehiiv
            form ID or embed snippet (see <code>.env.example</code>), then restart <code>npm run dev</code>.
          </p>
        </div>
      )}
    </div>
  </div>
</section>
