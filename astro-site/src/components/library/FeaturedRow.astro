---
import ResourceCard from './ResourceCard.astro';
import type { FeaturedResource } from '../../lib/types';

interface Props {
  featured: FeaturedResource[];
}

const { featured } = Astro.props;
---

<div class="lib-featured">
  {
    featured.map((item) =>
      item.resource ? (
        <ResourceCard resource={item.resource} featuredLabel={item.label} />
      ) : (
        <a href={item.fallbackHref} class="resource-card">
          <div class="resource-card__header">
            <span class="resource-card__badge resource-card__badge--featured">{item.label}</span>
            <span class="resource-card__badge">Guide</span>
          </div>
          <h3 class="resource-card__title">{item.fallbackTitle}</h3>
          {item.fallbackSummary && (
            <p class="resource-card__summary">{item.fallbackSummary}</p>
          )}
          <span class="resource-card__action">
            {item.fallbackAction}
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      )
    )
  }
</div>
