---
interface Props {
  variant?: 'default' | 'compact';
}

const { variant = 'default' } = Astro.props;
---

<aside
  class:list={['lib-basics-callout', { 'lib-basics-callout--compact': variant === 'compact' }]}
  aria-label="Start with the basics"
>
  <div class="lib-basics-callout__content">
    <p class="lib-basics-callout__eyebrow">Before you begin</p>
    <h2 class="lib-basics-callout__title">Read the Basics of Training first</h2>
    <p class="lib-basics-callout__text">
      Before progressing any further, make sure you have read and understand the fundamentals.
      The rest of the library assumes this foundation.
    </p>
  </div>
  <a href="/basics" class="lib-basics-callout__cta">
    Read the Basics
    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </a>
</aside>
