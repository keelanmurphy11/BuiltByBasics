---
import type { MovementPattern } from '../lib/types';

interface Props {
  patterns: MovementPattern[];
}

const { patterns } = Astro.props;
---

<div id="movement-patterns-section" class="pattern-library" data-reveal-stagger>
  <div class="pattern-library__header reveal-item">
    <h2 class="pattern-library__title">Movement Pattern Library</h2>
    <p class="pattern-library__intro">
      Pick any exercise that fits the pattern for your program slot. Additional programs and
      examples are being added regularly.
    </p>
  </div>
  <div class="pattern-library__list">
    {
      patterns.map((pattern, index) => {
        const panelId = `pattern-panel-${pattern.slug}`;
        const toggleId = `pattern-toggle-${pattern.slug}`;
        const isFirst = index === 0;
        const examples = (pattern.examples || []).join(' · ');

        return (
          <div class:list={['pattern-card reveal-item', isFirst && 'pattern-card--open']}>
            <button
              type="button"
              class="pattern-card__toggle"
              aria-expanded={isFirst ? 'true' : 'false'}
              aria-controls={panelId}
              id={toggleId}
              data-pattern-toggle
            >
              <span class="pattern-card__label">{pattern.title}</span>
              <span class="pattern-card__chevron" aria-hidden="true">
                <svg
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>
            <div
              class="pattern-card__panel"
              id={panelId}
              role="region"
              aria-labelledby={toggleId}
              hidden={!isFirst}
              data-pattern-panel
            >
              <p class="pattern-card__examples">{examples}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<script>
  document.querySelectorAll('[data-pattern-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const list = toggle.closest('.pattern-library__list');
      if (!list) return;

      const card = toggle.closest('.pattern-card');
      const panel = card?.querySelector('[data-pattern-panel]');
      if (!card || !panel) return;

      const isOpen = toggle.getAttribute('aria-expanded') === 'true';

      list.querySelectorAll('.pattern-card').forEach((item) => {
        const btn = item.querySelector('[data-pattern-toggle]');
        const pnl = item.querySelector('[data-pattern-panel]');
        item.classList.remove('pattern-card--open');
        btn?.setAttribute('aria-expanded', 'false');
        if (pnl instanceof HTMLElement) {
          pnl.hidden = true;
        }
      });

      if (!isOpen) {
        card.classList.add('pattern-card--open');
        toggle.setAttribute('aria-expanded', 'true');
        if (panel instanceof HTMLElement) {
          panel.hidden = false;
        }
      }
    });
  });
</script>
