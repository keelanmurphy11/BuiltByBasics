---
import {
  formatDate,
  formatDifficulty,
  formatReadingTime,
  getEvidenceLabel,
} from '../lib/library-utils';

interface Props {
  readingTime: number;
  difficulty?: string;
  publishedAt?: string;
  updatedAt?: string;
  evidenceLevel?: string;
}

const { readingTime, difficulty, publishedAt, updatedAt, evidenceLevel } = Astro.props;
const evidenceLabel = getEvidenceLabel(evidenceLevel);
---

<div class="article-meta">
  <span class="article-meta__pill">{formatReadingTime(readingTime)}</span>
  {difficulty && <span class="article-meta__pill">{formatDifficulty(difficulty)}</span>}
  {publishedAt && <span class="article-meta__pill">Published {formatDate(publishedAt)}</span>}
  {updatedAt && <span class="article-meta__pill">Updated {formatDate(updatedAt)}</span>}
  {evidenceLabel && <span class="article-meta__pill article-meta__pill--evidence">{evidenceLabel}</span>}
</div>
