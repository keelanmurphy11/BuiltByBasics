---
import type { ArticleSummary } from '../lib/types';
import ResourceCard from './library/ResourceCard.astro';
import { normalizeResource } from '../lib/library-utils';

interface Props {
  article: ArticleSummary;
  class?: string;
  featuredLabel?: string;
}

const { article, class: className, featuredLabel } = Astro.props;
const resource = normalizeResource({
  _id: article._id,
  _type: 'article',
  title: article.title,
  slug: article.slug,
  summary: article.summary,
  status: article.status,
  publishedAt: article.publishedAt,
  topics: article.topics,
  difficulty: article.difficulty,
  evidenceLevel: article.evidenceLevel,
  popularityScore: article.popularityScore,
  _updatedAt: article._updatedAt,
});
---

<ResourceCard
  resource={resource}
  class={className}
  featuredLabel={featuredLabel}
  showType={false}
/>
