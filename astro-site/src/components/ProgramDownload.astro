---
interface Props {
  url?: string;
  title?: string;
}

const { url, title = 'Download Program PDF' } = Astro.props;

if (!url) return null;
---

<div class="program-download">
  <a href={url} class="program-download__btn" download target="_blank" rel="noopener noreferrer">
    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    {title}
  </a>
</div>
