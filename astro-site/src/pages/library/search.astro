---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LibrarySearch from '../../components/library/LibrarySearch.astro';
import CategoryChips from '../../components/library/CategoryChips.astro';
import ResourceFeed from '../../components/library/ResourceFeed.astro';
import { fetchSanity } from '../../lib/sanity';
import { libraryResourcesQuery } from '../../lib/queries';
import { normalizeResources, sortResources } from '../../lib/library-utils';
import type { LibraryResourceRaw } from '../../lib/types';

const rawResources = (await fetchSanity<LibraryResourceRaw[]>(libraryResourcesQuery)) ?? [];
const resources = sortResources(normalizeResources(rawResources), 'newest');

const indexData = resources.map((r) => ({
  id: r.id,
  type: r.type,
  resourceType: r.resourceType,
  title: r.title,
  slug: r.slug,
  summary: r.summary,
  href: r.href,
  actionLabel: r.actionLabel,
  topics: r.topics,
  difficulty: r.difficulty,
  experienceLevel: r.experienceLevel,
  popularityScore: r.popularityScore,
  publishedAt: r.publishedAt,
  updatedAt: r.updatedAt,
  readingTime: r.readingTime,
  duration: r.duration,
  evidenceLevel: r.evidenceLevel,
}));
---

<BaseLayout
  title="Search Library - builtbybasics"
  description="Search and browse evidence-based training programs, articles, and guides."
  extraCss={['/css/library.css']}
  bodyClass="library-page"
  activeNav="library"
>
  <main class="library-main">
    <section class="lib-search-page-hero">
      <div class="library-container">
        <a href="/library" class="lib-index-hero__back">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Back to Library
        </a>
        <h1 class="lib-search-page-hero__title">Browse Resources</h1>
        <p class="lib-search-page-hero__desc">
          Search programs and articles, then refine results with filters below.
        </p>

        <form class="lib-search-page-hero__form" action="/library/search" method="get" role="search">
          <LibrarySearch
            variant="hero"
            searchId="library-search"
            inputName="q"
            showSubmit
          />
        </form>

        <CategoryChips />
      </div>
    </section>

    <section class="lib-section">
      <div class="library-container">
        <ResourceFeed
          resources={resources}
          showSearch={false}
          enableHub={true}
          sectionIntro="Use filters to narrow by topic, format, or difficulty."
        />
      </div>
    </section>
  </main>

  <script id="library-index" type="application/json" set:html={JSON.stringify(indexData)} />
</BaseLayout>
