---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopicBrowse from '../../components/library/TopicBrowse.astro';
import SanityDevNotice from '../../components/SanityDevNotice.astro';
import { fetchSanity } from '../../lib/sanity';
import { articlesQuery, libraryResourcesQuery } from '../../lib/queries';
import { aggregateTopicCounts, normalizeResources } from '../../lib/library-utils';
import type { ArticleSummary, LibraryResourceRaw } from '../../lib/types';

const articles = (await fetchSanity<ArticleSummary[]>(articlesQuery)) ?? [];

const rawResources = (await fetchSanity<LibraryResourceRaw[]>(libraryResourcesQuery)) ?? [];
const articleResources = normalizeResources(rawResources).filter((r) => r.type === 'article');
const topicCounts = aggregateTopicCounts(articleResources);
---

<BaseLayout
  title="Expand Your Knowledge - builtbybasics"
  description="Evidence-based articles on training, nutrition, and lifestyle from builtbybasics."
  extraCss={['/css/library.css']}
  bodyClass="library-page"
  activeNav="library"
>
  <main class="library-main">
    <section class="lib-index-hero">
      <div class="library-container">
        <SanityDevNotice />
        <a href="/library" class="lib-index-hero__back">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Back to Library
        </a>
        <h1 class="lib-index-hero__title">Expand Your Knowledge</h1>
        <p class="lib-index-hero__desc">
          In-depth reads on training, nutrition, and lifestyle. Building on the <a href="/basics" style="color: #3b82f6; text-decoration: none;">Basics of Training</a>.
        </p>
      </div>
    </section>

    <section class="lib-section lib-section--compact">
      <div class="library-container">
        <TopicBrowse topicCounts={topicCounts} />
      </div>
    </section>

    <section class="lib-section">
      <div class="library-container">
        <div class="lib-index-grid">
          {
            articles.length ? (
              articles.map((article) => <ArticleCard article={article} />)
            ) : (
              <p class="lib-feed__empty">
                No articles published yet. Add articles in Sanity Studio or run{' '}
                <code>npm run seed</code> in <code>studio/</code>.
              </p>
            )
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
