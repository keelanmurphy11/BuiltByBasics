{
  "name": "builtbybasics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:canvas && npm run build:react",
    "build:canvas": "node ./node_modules/esbuild/bin/esbuild src/research-telemetry-bg.ts --bundle --outfile=js/research-telemetry-bg.js --format=iife --target=es2020 --minify --banner:js=\"/* Built from src/research-telemetry-bg.ts - edit source and run: npm run build:canvas */\"",
    "build:react": "node ./node_modules/vite/bin/vite.js build",
    "build:site": "npm run build --prefix astro-site",
    "dev:canvas": "node ./node_modules/esbuild/bin/esbuild src/research-telemetry-bg.ts --bundle --outfile=js/research-telemetry-bg.js --format=iife --target=es2020 --watch",
    "dev:studio": "npm run dev --prefix studio",
    "dev:site": "npm run dev --prefix astro-site",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
